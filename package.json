{
  "name": "patina",
  "version": "0.1.0",
  "private": true,
  "description": "Patina: shared React Aria Components wrappers and composite components for the owner's web apps",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "husky",
    "check": "pnpm -r run check && tsgo --noEmit",
    "lint": "oxlint --type-aware .",
    "lint:es": "eslint --max-warnings=0 .",
    "lint:fix": "eslint --config eslint.autofix.config.mjs --fix packages/aria apps/storybook && node scripts/format.mjs --write",
    "format": "node scripts/format.mjs --write",
    "format:check": "node scripts/format.mjs --check",
    "test": "pnpm -r --workspace-concurrency=1 --if-present --no-bail run test",
    "storybook": "pnpm --filter @skonkwerks/storybook run dev",
    "build:storybook": "pnpm --filter @skonkwerks/storybook run build"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.18.1",
    "eslint-plugin-react-dom": "^5.30.3",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "eslint-plugin-react-x": "^5.30.3",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2007",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2"
  }
}
