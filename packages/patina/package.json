{
  "name": "@skonkwerks/patina",
  "version": "0.1.0",
  "private": true,
  "description": "Styled wrappers around React Aria Components, themed with Tailwind tokens. Depends only on React and React DOM, React Aria Components, Tabler icons, Motion, tailwind-variants (with tailwind-merge) and Immer.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./patina.css": "./patina.css"
  },
  "files": [
    "dist",
    "patina.css",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "pnpm run build",
    "check": "tsgo --noEmit",
    "lint": "oxlint --type-aware .",
    "test": "vitest run"
  },
  "dependencies": {
    "immer": "^11.2.10",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.3.1"
  },
  "peerDependencies": {
    "@tabler/icons-react": "^3.52.0",
    "motion": "^14.14.0",
    "react": "^19.2.0",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@internationalized/date": "^3.12.4",
    "@storybook/react-vite": "^10.6.7",
    "@tabler/icons-react": "^3.52.0",
    "@types/react": "19.2.8",
    "@types/react-dom": "19.2.3",
    "motion": "^14.14.0",
    "react": "19.2.8",
    "react-aria-components": "^1.22.1",
    "react-dom": "19.2.8",
    "storybook": "^10.6.7",
    "tailwindcss": "^4.3.3",
    "vitest": "^5.1.0"
  }
}
